{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/lint-typecheck.cjs",
            "async": true,
            "statusMessage": "Linting & type-checking touched file..."
          }
        ]
      }
    ]
  }
}
